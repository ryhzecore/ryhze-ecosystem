{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {"name":"base","hidden":true,"generator":"Ninja","binaryDir":"${sourceDir}/out/${presetName}","cacheVariables":{"CMAKE_CXX_COMPILER":"/usr/bin/clang++"}},
    {"name":"debug","inherits":"base","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug"}},
    {"name":"release","inherits":"base","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"asan","inherits":"base","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","RACE_SANITIZER":"address"}},
    {"name":"tsan","inherits":"base","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","RACE_SANITIZER":"thread"}},
    {"name":"windows-debug","generator":"Ninja","binaryDir":"${sourceDir}/out/${presetName}","condition":{"type":"equals","lhs":"${hostSystemName}","rhs":"Windows"},"cacheVariables":{"CMAKE_CXX_COMPILER":"cl","CMAKE_BUILD_TYPE":"Debug"}},
    {"name":"windows-release","generator":"Ninja","binaryDir":"${sourceDir}/out/${presetName}","condition":{"type":"equals","lhs":"${hostSystemName}","rhs":"Windows"},"cacheVariables":{"CMAKE_CXX_COMPILER":"cl","CMAKE_BUILD_TYPE":"Release"}}
  ],
  "buildPresets": [
    {"name":"debug","configurePreset":"debug","jobs":4},
    {"name":"release","configurePreset":"release","jobs":4},
    {"name":"asan","configurePreset":"asan","jobs":4},
    {"name":"tsan","configurePreset":"tsan","jobs":4},
    {"name":"windows-debug","configurePreset":"windows-debug","jobs":4},
    {"name":"windows-release","configurePreset":"windows-release","jobs":4}
  ],
  "testPresets": [
    {"name":"debug","configurePreset":"debug","output":{"outputOnFailure":true}},
    {"name":"release","configurePreset":"release","output":{"outputOnFailure":true}},
    {"name":"asan","configurePreset":"asan","environment":{"ASAN_OPTIONS":"detect_leaks=1:strict_string_checks=1"},"output":{"outputOnFailure":true}},
    {"name":"tsan","configurePreset":"tsan","output":{"outputOnFailure":true}},
    {"name":"windows-debug","configurePreset":"windows-debug","output":{"outputOnFailure":true}},
    {"name":"windows-release","configurePreset":"windows-release","output":{"outputOnFailure":true}}
  ]
}
