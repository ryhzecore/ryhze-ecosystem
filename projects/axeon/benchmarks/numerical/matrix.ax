// Four ordered 4-term dot products per iteration; coefficient norm is < 1.
fn kernel(n: i64) -> i64 {
    let matrix: [f64;16] = [
        0.5, 0.125, 0.0625, 0.03125,
        0.03125, 0.5, 0.125, 0.0625,
        0.0625, 0.03125, 0.5, 0.125,
        0.125, 0.0625, 0.03125, 0.5,
    ];
    let forcing: [f64;4] = [0.03125, -0.015625, 0.0078125, -0.00390625];
    let mut state: [f64;4] = [0.125, -0.25, 0.375, -0.5];
    let mut next: [f64;4] = [0.0, 0.0, 0.0, 0.0];
    let coefficients: &[f64] = &matrix;
    let mut i: i64 = 0;
    while i < n {
        let drive: f64 = f64_from_i64(i % 97) / 97.0 - 0.5;
        {
            let input: &[f64] = &state;
            let output: &mut[f64] = &mut next;
            let mut row: i64 = 0;
            while row < 4 {
                let mut acc: f64 = 0.0;
                let mut col: i64 = 0;
                while col < 4 {
                    acc = acc + coefficients[row * 4 + col] * input[col];
                    col = col + 1;
                }
                output[row] = acc + forcing[row] * drive;
                row = row + 1;
            }
        }
        let mut copy: i64 = 0;
        while copy < 4 {
            state[copy] = next[copy];
            copy = copy + 1;
        }
        i = i + 1;
    }
    let mut checksum: f64 = 0.0;
    let mut element: i64 = 0;
    while element < 4 {
        checksum = checksum + state[element];
        element = element + 1;
    }
    return f64_bits(checksum);
}

fn main() -> i64 { return kernel(1); }
