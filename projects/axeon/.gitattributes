benchmarks/results/kernel.ll whitespace=-blank-at-eof
benchmarks/**/*.csv whitespace=cr-at-eol
benchmarks/**/*.ll whitespace=-blank-at-eof
benchmarks/**/*.svg whitespace=-blank-at-eol
evidence/*.log whitespace=-blank-at-eof
evidence/**/*.log whitespace=-blank-at-eof
evidence/**/*.ll whitespace=-blank-at-eof
evidence/**/*.stdout whitespace=-blank-at-eof
