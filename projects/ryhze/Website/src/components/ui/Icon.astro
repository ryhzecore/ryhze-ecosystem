---
import { iconPaths, type IconName } from '@/data/icons';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={iconPaths[name]} />
</svg>
