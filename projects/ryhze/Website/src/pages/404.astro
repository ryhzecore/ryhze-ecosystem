    <p class="eyebrow">404 / A little off the map</p>
    <h1>
      This world is
      <br />
      <span class="text-accent">still undiscovered.</span>
    </h1>
    <p>The page you’re looking for isn’t here.</p>
    <Button href="/">Back to Ryhze</Button>
  </section>
</SiteLayout>
