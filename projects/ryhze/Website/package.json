{
  "name": "ryhze-website",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Ryhze pre-alpha frontend with separately preserved invited-tester account preparation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run auth:build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run performance && npm run hosting:check && npm run hosting:dry-run && npm run production:check",
    "assets:images": "node scripts/optimize-images.mjs",
    "performance": "node scripts/performance-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hosting:check": "node hosting/preflight.mjs",
    "hosting:dry-run": "wrangler deploy --dry-run --outdir .local/worker-bundle",
    "auth:build": "node scripts/build-auth-assets.mjs",
    "auth:check": "npm run auth:build && node --test tests/tester-*.test.mjs",
    "auth:plan": "node scripts/manage-testers.mjs",
    "production:check": "node deployment/public/prepare.mjs && node --test deployment/public/tests/*.test.mjs && wrangler deploy --config deployment/public/wrangler.json --dry-run --outdir .local/public-production-worker",
    "account:preview:build": "astro build --config preview/account/astro.config.mjs",
    "account:preview:check": "npm run account:preview:build && node --test tests/account-preview*.test.mjs",
    "pretest": "npm run account:preview:build"
  },
  "dependencies": {
    "@clerk/backend": "3.21.1",
    "@clerk/clerk-js": "6.36.0",
    "astro": "7.3.5",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "css-tree": "3.2.1",
    "linkedom": "0.18.13",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "terser": "5.44.0",
    "typescript": "5.9.3",
    "wrangler": "4.145.0"
  }
}
