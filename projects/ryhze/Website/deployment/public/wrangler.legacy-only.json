{
  "name": "ryhze-website-public",
  "main": "legacy-only.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "LEGACY",
      "service": "ryhze-web"
    }
  ],
  "routes": [
    {
      "pattern": "https://ryhze.com/*",
      "zone_name": "ryhze.com"
    },
    {
      "pattern": "http://ryhze.com/*",
      "zone_name": "ryhze.com"
    },
    {
      "pattern": "https://www.ryhze.com/*",
      "zone_name": "ryhze.com"
    },
    {
      "pattern": "http://www.ryhze.com/*",
      "zone_name": "ryhze.com"
    }
  ],
  "observability": {
    "enabled": false
  },
  "send_metrics": false
}
